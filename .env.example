# 伺服器端（Vercel Environment Variables，絕不進前端、絕不進 git）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 前端：要用哪個分析器。留空或 rule_based = 離線規則式；gemini = 走 /api/analyze
VITE_ANALYZER=rule_based

# 選配：匿名作答的資料收集（Supabase 單表）。兩個都留空就完全不會上傳。
# anon key 本來就設計成可公開，資料表的 RLS 只開放 INSERT（見 docs/supabase.sql）。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
